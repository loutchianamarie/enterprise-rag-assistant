# Copy to .env and set values only if needed. Do not commit .env.
RAG_INDEX_PATH=index.json
RAG_EMBEDDING_BACKEND=hash
# RAG_EMBEDDING_BACKEND=fastembed
# RAG_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_GENERATOR=extractive
# RAG_GENERATOR=ollama
# RAG_OLLAMA_URL=http://127.0.0.1:11434
# RAG_OLLAMA_MODEL=llama3.2:3b
# RAG_GENERATOR=openai
# RAG_OPENAI_BASE_URL=https://api.openai.com/v1
